repositories:

  _externals/contools:
    type:         git
    url:          https://github.com/andry81/contools
    version:      master
    subpaths:
      - __init__
      - _config
      - scripts/__init__
      - scripts/tools/__init__
      - scripts/tools/filesys
      - scripts/tools/sqlite
      - scripts/tools/std
      - scripts/tools/testlib
      - scripts/tools/time
      - scripts/tools/wmi
      - scripts/tools/xcopy

  _externals/sqlite:
    type:         git
    url:          https://github.com/andry81-3dparty/external-tools--sqlite3
    version:      3_15_0_release
